# ASTRA Health - Environment Configuration Template
# Copy this file to .env and provide your configuration.
# DO NOT commit .env with real secrets to version control.

# Google Gemini API Key (Required for Online Gemini Intelligence mode)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=

# NASA Open Data API Key (Optional, defaults to DEMO_KEY if blank)
# Obtain a key from https://api.nasa.gov/
NASA_API_KEY=

# Server Configuration (Optional)
PORT=3000
NODE_ENV=development

